ber);margin:6px 0 4px}\n.card .unit{color:var(--muted);font-size:13px;margin-bottom:18px}\n.card ul{list-style:none;padding:0;margin:0}\n.card li{padding:9px 0;border-top:1px dashed rgba(143,176,201,.25);font-size:15px}\n.card li:first-child{border-top:none}\n\n/* 套餐：阶梯式递进 */\n.plans{background:linear-gradient(180deg,#0d2c4d,#0a2540)}\n.plan-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;align-items:end}\n.plan{position:relative;border-radius:22px;padding:30px 26px 34px;background:var(--card);box-shadow:var(--card-shadow);border:1px solid rgba(245,183,61,.12);transition:transform .2s}\n.plan:nth-child(1){transform:translateY(14px)}\n.plan:nth-child(2){transform:translateY(-6px);border-color:var(--amber);background:#14467a}\n.plan:nth-child(3){transform:translateY(22px)}\n.plan .badge{position:absolute;top:-14px;left:24px;background:var(--amber);color:var(--ink);font-weight:800;padding:6px 14px;border-radius:999px;font-size:12px;letter-spacing:.1em}\n.plan .tier{color:var(--muted);font-size:13px;letter-spacing:.2em;text-transform:uppercase}\n.plan .name{font-size:22px;color:var(--paper);margin:6px 0 2px}\n.plan .price{font-size:30px;font-weight:800;color:var(--amber)}\n.plan .annual{color:var(--text);font-size:13px;margin:2px 0 18px}\n.plan ul{list-style:none;padding:0;margin:0}\n.plan li{padding:10px 0;border-top:1px dashed rgba(143,176,201,.22);font-size:15px}\n\n/* FAQ 按主题分组 */\n.faq-group{margin-bottom:36px}\n.faq-group h3{font-size:15px;letter-spacing:.2em;text-transform:uppercase;color:var(--amber);margin-bottom:18px;padding-bottom:8px;border-bottom:1px solid var(--line)}\n.qa{margin-bottom:16px}\n.qa .q{color:var(--paper);font-weight:600;margin-bottom:6px;font-size:16px}\n.qa .a{color:var(--text);font-size:15px}\n\n/* 客户端说明 */\n.clients .note{background:var(--card);border-radius:22px;padding:28px;box-shadow:var(--card-shadow);border:1px solid rgba(245,183,61,.12)}\n.clients .row{display:flex;gap:16px;flex-wrap:wrap;margin-top:18px}\n.clients .chip{padding:8px 16px;border-radius:999px;border:1px solid rgba(245,183,61,.3);color:var(--paper);font-size:14px}\n\n/* 使用说明 */\n.steps{counter-reset:step;display:grid;grid-template-columns:repeat(2,1fr);gap:20px}\n.step{background:var(--card);border-radius:22px;padding:26px;box-shadow:var(--card-shadow);border:1px solid rgba(245,183,61,.12);counter-increment:step}\n.step::before{content:counter(step,decimal-leading-zero);color:var(--amber);font-weight:800;font-size:14px;letter-spacing:.1em}\n.step h3{color:var(--paper);font-size:18px;margin:10px 0 6px}\n.step p{font-size:15px;margin:0;color:var(--text)}\n\nfooter{padding:48px 0 64px;background:#08203b;border-top:1px solid var(--line);color:var(--muted);font-size:14px}\nfooter .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px}\nfooter a{color:var(--text)}\n\n@media (max-width:820px){\n  .plan-grid{grid-template-columns:1fr;gap:18px}\n  .plan:nth-child(n){transform:none}\n  .steps{grid-template-columns:1fr}\n  .hero{padding:64px 0 48px}\n  .hero h1{font-size:34px}\n}\n</style><main>\n\n\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"kicker\">UENX · 连接工程</div>\n    <h1>UENX · 重建你与世界的连接方式</h1>\n    <div class=\"lead\">\n      <p>网络不该是猜谜。UENX 把线路、节点和带宽拆解成可读的工程问题：用什么协议走，走哪条专线，限不限流，解锁到什么程度，都写在台面上。</p>\n      <p>从一台设备到二十人团队，从追剧到跨区协作，UENX 给出三档明码标价的方案。不打包废话，不卖模糊承诺。</p>\n    </div>\n    <div class=\"meta\">三条产品线 · 明码标价 · 不绑定长合约</div>\n\n    <nav class=\"anchors\" aria-label=\"页面导航\">\n      <a href=\"#plans\">查看方案</a>\n      <a href=\"#how\">使用方式</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n\n<section id=\"plans\" class=\"plans\">\n  <div class=\"wrap\">\n    <h2>三档方案，对应三种使用强度</h2>\n    <p>价格公开，按月或按年均可，按年付享折扣。</p>\n\n    <div class=\"plan-grid\">\n      <article class=\"plan\">\n        <div class=\"tier\">第一档</div>\n        <div class=\"name\">基础版</div>\n        <div class=\"price\">¥15/月</div>\n        <div class=\"annual\">按年付仅需 ¥150/年</div>\n        <ul>\n          <li>每月 100GB 高速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </article>\n\n      <article class=\"plan\">\n        <span class=\"badge\">推荐</span>\n        <div class=\"tier\">第二档</div>\n        <div class=\"name\">旗舰版</div>\n        <div class=\"price\">¥35/月</div>\n        <div class=\"annual\">按年付仅需 ¥350/年</div>\n        <ul>\n          <li>每月 300GB 高速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"tier\">第三档</div>\n        <div class=\"name\">团队版</div>\n        <div class=\"price\">¥85/月</div>\n        <div class=\"annual\">按年付仅需 ¥850/年</div>\n        <ul>\n          <li>每月 1000GB 高速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"how\">\n  <div class=\"wrap\">\n    <h2>四步完成接入</h2>\n    <p>没有复杂配置，按顺序操作即可。</p>\n    <div class=\"steps\">\n      <div class=\"step\">\n        <h3>选择方案</h3>\n        <p>根据设备数量和流量需求，从基础版、旗舰版、团队版中选一档。</p>\n      </div>\n      <div class=\"step\">\n        <h3>创建账户</h3>\n        <p>填写邮箱，设置密码，完成注册后进入控制面板。</p>\n      </div>\n      <div class=\"step\">\n        <h3>下载客户端</h3>\n        <p>在控制面板获取对应平台的客户端，或导入通用订阅地址。</p>\n      </div>\n      <div class=\"step\">\n        <h3>选择节点并连接</h3>\n        <p>打开客户端，从节点列表中选择目标区域，点击连接即开始使用。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"clients\" class=\"clients\">\n  <div class=\"wrap\">\n    <h2>客户端与平台</h2>\n    <div class=\"note\">\n      <p>UENX 提供通用订阅地址，可直接导入主流客户端使用。具体下载地址以控制面板内提供的链接为准，请登录账户后获取。</p>\n      <p>未提供独立客户端时，可使用兼容订阅协议的第三方工具接入。</p>\n      <div class=\"row\" aria-label=\"支持平台\">\n        <span class=\"chip\">Windows</span>\n        <span class=\"chip\">macOS</span>\n        <span class=\"chip\">Linux</span>\n        <span class=\"chip\">Android</span>\n        <span class=\"chip\">iOS</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"faq\">\n  <div class=\"wrap\">\n    <h2>常见问题</h2>\n    <p>按主题分组，直接看你需要的那块。</p>\n\n    <div class=\"faq-group\">\n      <h3>方案与计费</h3>\n      <div class=\"qa\">\n        <div class=\"q\">月付和年付可以随时切换吗？</div>\n        <div class=\"a\">可以。在控制面板中对当前方案进行升级或续费时，系统会按剩余周期折算，不会重复扣费。</div>\n      </div>\n      <div class=\"qa\">\n        <div class=\"q\">流量用完了怎么办？</div>\n        <div class=\"a\">流量耗尽后连接会暂停，可在控制面板单独购买流量附加包，或等待下一周期自动恢复。</div>\n      </div>\n      <div class=\"qa\">\n        <div class=\"q\">支持退款吗？</div>\n        <div class=\"a\">具体退款政策以购买时页面说明为准。建议先选择月付方案试用，确认体验后再考虑按年续费。</div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>设备与使用</h3>\n      <div class=\"qa\">\n        <div class=\"q\">同一账户能在多台设备同时使用吗？</div>\n        <div class=\"a\">可以，同时在线数量取决于所选方案：基础版 3 台，旗舰版 5 台，团队版 20 台。超出限制时最早连接会被顶替。</div>\n      </div>\n      <div class=\"qa\">\n        <div class=\"q\">需要手动配置吗？</div>\n        <div class=\"a\">不需要。客户端内置订阅，登录后自动同步节点列表，选择节点后一键连接即可。</div>\n      </div>\n      <div class=\"qa\">\n        <div class=\"q\">支持哪些平台？</div>\n        <div class=\"a\">覆盖 Windows、macOS、Linux、Android、iOS，未提供独立客户端时可使用兼容订阅的第三方工具。</div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>线路与性能</h3>\n      <div class=\"qa\">\n        <div class=\"q\">基础版和旗舰版的线路有什么区别？</div>\n        <div class=\"a\">基础版使用普通线路节点池，旗舰版在此基础上增加 IPLC 专线与原生流媒体解锁，并享有游戏加速优化。</div>\n      </div>\n      <div class=\"qa\">\n        <div class=\"q\">流媒体解锁到什么程度？</div>\n        <div class=\"a\">基础版解锁基础流媒体，旗舰版与团队版提供全节点原生解锁，具体可用内容以目标平台政策为准。</div>\n      </div>\n      <div class=\"qa\">\n        <div class=\"q\">团队版能定制路由吗？</div>\n        <div class=\"a\">可以。团队版支持企业定制路由，并配有专属客户经理协助配置。</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap\">\n    <div>UENX · 重建你与世界的连接方式</div>\n    <div>\n      <a href=\"#plans\">方案</a> ·\n      <a href=\"#how\">使用</a> ·\n      <a href=\"#clients\">客户端</a> ·\n      <a href=\"#faq\">FAQ</a>\n    </div>\n    <div>内容仅供参考，不构成任何服务承诺。</div>\n  </div>\n</footer>\n\n</main>",
